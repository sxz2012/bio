% Macros for the study guides (<T>-guide.tex). Loaded after preamble.tex.
\ProvidesPackage{guide}
\RequirePackage{tabularx}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\fancyhead[L]{\small\sffamily SHAWN'S BIOLOGY}

% ---- front matter
% \guidetitle{1A}{title}{learning target statement}
\newcommand{\guidetitle}[3]{%
  \fancyhead[R]{\small\sffamily ECOLOGY\quad #1 STUDY GUIDE}%
  \thispagestyle{empty}
  {\sffamily\small\color{forest} ECOLOGY UNIT\quad·\quad LEARNING TARGET #1\par}
  \vspace{4pt}{\raggedright\sffamily\bfseries\huge\color{forest} #2\par}\vspace{10pt}
  \begin{tcolorbox}[colback=pale,colframe=forest,boxrule=0.6pt,arc=2pt,left=10pt,right=10pt,top=8pt,bottom=8pt]
  {\sffamily\bfseries\color{forest} Learning target #1}\par\large #3
  \end{tcolorbox}}
% the color key for the notes
\newcommand{\notelegend}{\par\medskip{\sffamily\small
  \circlednum{keyc}{1}~\textcolor{keyc}{\textbf{Key idea}}\quad
  \circlednum{vocabc}{2}~\textcolor{vocabc}{\textbf{Vocabulary}}\quad
  \circlednum{tipc}{3}~\textcolor{tipc}{\textbf{Make it make sense}}\quad
  \circlednum{watchc}{4}~\textcolor{watchc}{\textbf{Watch out}}\quad
  \circlednum{linkc}{5}~\textcolor{linkc}{\textbf{Connection}}\par}}

% ---- annotated textbook pages
% \begin{tbpage}{book page}{lesson}{intro}
%   \tbnote{kind}{label}{find}{to}{text}
% \end{tbpage}
% kind: key, vocab, tip, watch, link. label: empty = the kind's default heading.
% find/to: the words to highlight on the page, exactly as printed (to may be empty; find empty = a
% page-level note with no highlight). LaTeX ignores find/to: build.py matches them against the scan's
% OCR text and writes the highlight boxes to build/anchors/<T>.tex, which the document loads.
\def\kc@key{keyc}\def\kc@vocab{vocabc}\def\kc@tip{tipc}\def\kc@watch{watchc}\def\kc@link{linkc}
\def\kl@key{Key idea}\def\kl@vocab{Vocabulary}\def\kl@tip{Make it make sense}\def\kl@watch{Watch out}\def\kl@link{Connection}
\newcount\tbk
\newcounter{tbnum}
% anchor data, written by build.py
\newcommand{\tbpageinfo}[4]{\expandafter\gdef\csname tbP@#1\endcsname{{\sgroot#2}{#3}{#4}}}
\newcommand{\tbanchor}[5]{% page, note index, anchor y, gutter x, rectangles
  \expandafter\gdef\csname tbA@#1@#2\endcsname{#3}%
  \expandafter\gdef\csname tbG@#1@#2\endcsname{#4}%
  \expandafter\gdef\csname tbR@#1@#2\endcsname{#5}}
\newcommand{\tbnote}[5]{%
  \global\advance\tbk by 1 \stepcounter{tbnum}%
  \edef\tb@c{\csname kc@#1\endcsname}%
  \expandafter\xdef\csname tbC@\tbpg @\the\tbk\endcsname{\tb@c}%
  \expandafter\xdef\csname tbN@\tbpg @\the\tbk\endcsname{\thetbnum}%
  \expandafter\ifx\csname tbA@\tbpg @\the\tbk\endcsname\relax
    \PackageError{guide}{No anchor for note \the\tbk\space on page \tbpg. Run build.py}{}\fi
  \edef\tb@y{\csname tbA@\tbpg @\the\tbk\endcsname}%
  \ifx\relax#2\relax\edef\tb@l{\csname kl@#1\endcsname}\else\def\tb@l{#2}\fi
  \expandafter\addnote\expandafter{\tb@c}{\thetbnum}{\tb@l}{\tb@y}{#5}}
% one highlight rectangle, in the current note's color \c (set in \tbdrawhls)
\newcommand{\tbrect}[4]{\hl{\c}{#1}{#2}{#3}{#4}}
\newcommand{\tbdrawhls}{%
  \ifnum\tbk>0
    \foreach \j in {1,...,\the\tbk}{%
      \edef\c{\csname tbC@\tbpg @\j\endcsname}\edef\y{\csname tbA@\tbpg @\j\endcsname}%
      \ifdim\y pt<0pt\else
        \csname tbR@\tbpg @\j\endcsname
        \badge{\c}{\csname tbN@\tbpg @\j\endcsname}{\csname tbG@\tbpg @\j\endcsname}{\y}%
      \fi}%
  \fi}
\NewEnviron{tbpage}[3]{%
  \xdef\tbpg{#1}\global\tbk=0
  \expandafter\ifx\csname tbP@#1\endcsname\relax
    \PackageError{guide}{No page data for textbook page #1. Run build.py}{}\fi
  \expandafter\expandafter\expandafter\tbpage@go\csname tbP@#1\endcsname{#2}{#1}{#3}}
\def\tbpage@go#1#2#3#4#5#6{\textbookpage{#1}{#2}{#3}{#4}{#5}{#6}{\tbdrawhls}{\global\tbk=0 \BODY}}
